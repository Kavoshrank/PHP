{
  "name": "kavoshrank/php",
  "description": "Official PHP SDK for KavoshRank AI SEO, Content Automation, Audio Studio, and Storefront Copilot.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "kavoshrank",
    "seo",
    "ai",
    "content-automation",
    "podcast",
    "copilot",
    "sdk"
  ],
  "authors": [
    {
      "name": "KavoshRank Team",
      "homepage": "https://kavoshrank.ir"
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "ext-curl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "KavoshRank\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "KavoshRank\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
